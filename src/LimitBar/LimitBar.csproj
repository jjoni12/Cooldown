<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>LimitBar</AssemblyName>
    <RootNamespace>LimitBar</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.1</Version>
    <Product>LimitBar</Product>
    <Description>AI coding tool usage limits on the Windows taskbar.</Description>
    <!-- The exe records where its symbols were built; keeps the builder's folder and user name out of it. -->
    <PathMap>$(MSBuildProjectDirectory)=LimitBar</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logos\*.svg" LogicalName="logos.%(Filename).svg" />
    <EmbeddedResource Include="Assets\lang\*.json" LogicalName="lang.%(Filename).json" />
  </ItemGroup>

</Project>
