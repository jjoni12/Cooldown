<Window x:Class="LimitBar.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LimitBar"
        Width="392" Height="600" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="{DynamicResource TextFont}" FontSize="14"
        UseLayoutRounding="True">
  <Grid x:Name="Root">
  <Grid x:Name="PanelHost" Width="360" Margin="16" VerticalAlignment="Bottom">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="PanelShift" />
    </Grid.RenderTransform>
    <Border x:Name="Shadow" CornerRadius="8">
      <Border.Effect>
        <DropShadowEffect x:Name="ShadowEffect" BlurRadius="24" ShadowDepth="4" Direction="270" Color="Black" />
      </Border.Effect>
    </Border>

    <Border x:Name="Panel" CornerRadius="8" BorderThickness="1">
      <Grid x:Name="Body">
        <Grid VerticalAlignment="Bottom" Margin="0,0,0,48">
          <StackPanel x:Name="UsagePage" Grid.IsSharedSizeScope="True" />

          <Border x:Name="SettingsPage" Padding="24,14,24,14" Visibility="Collapsed">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="-8,0,0,8">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" />
                <TextBlock x:Name="SettingsTitle" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel x:Name="SettingsBody" />
            </StackPanel>
          </Border>
        </Grid>

        <Border x:Name="Footer" VerticalAlignment="Bottom" Height="48" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7">
          <Grid>
            <TextBlock x:Name="Updated" Margin="24,0,0,0" VerticalAlignment="Center" FontSize="12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
              <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" />
              <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Margin="4,0,0,0">
                <TextBlock x:Name="SettingsGlyph" Text="&#xE713;" Width="16" Height="16" TextAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform x:Name="SettingsSpin" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
  <Canvas x:Name="Overlay" />
  </Grid>
</Window>
